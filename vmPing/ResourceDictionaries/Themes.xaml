        <SolidColorBrush x:Key="Theme.Card.Border" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="Theme.Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="Theme.Text.Primary" Color="#111827"/>
        <SolidColorBrush x:Key="Theme.Text.Secondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="Theme.Text.Muted" Color="#9CA3AF"/>

        <SolidColorBrush x:Key="Theme.Status.Up.Background" Color="#D1FAE5"/>
        <SolidColorBrush x:Key="Theme.Status.Up.Foreground" Color="#047857"/>
        <SolidColorBrush x:Key="Theme.Status.Down.Background" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="Theme.Status.Down.Foreground" Color="#B91C1C"/>
        <SolidColorBrush x:Key="Theme.Status.Warning.Background" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Theme.Status.Warning.Foreground" Color="#B45309"/>
        <SolidColorBrush x:Key="Theme.Status.Error.Background" Color="#FFEDD5"/>
        <SolidColorBrush x:Key="Theme.Status.Error.Foreground" Color="#C2410C"/>
        <SolidColorBrush x:Key="Theme.Status.Info.Background" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="Theme.Status.Info.Foreground" Color="#1D4ED8"/>

        <SolidColorBrush x:Key="Theme.Badge.Background" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="Theme.Hover" Color="#0D2563EB"/>

        <sys:Double x:Key="Theme.Card.Blur">0</sys:Double>
    </ResourceDictionary>

    <!-- MODERN VIBRANT -->
    <ResourceDictionary x:Key="ColorfulTheme">
        <SolidColorBrush x:Key="Theme.Window.Background" Color="#F0F9FF"/>
        <SolidColorBrush x:Key="Theme.Window.GlassBackground" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="Theme.Window.Foreground" Color="#0C4A6E"/>
        <SolidColorBrush x:Key="Theme.Card.Background" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Theme.Card.Border" Color="#7DD3FC"/>
        <LinearGradientBrush x:Key="Theme.Accent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#6366F1" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Theme.Text.Primary" Color="#0F172A"/>
        <SolidColorBrush x:Key="Theme.Text.Secondary" Color="#334155"/>
        <SolidColorBrush x:Key="Theme.Text.Muted" Color="#64748B"/>

        <SolidColorBrush x:Key="Theme.Status.Up.Background" Color="#D1FAE5"/>
        <SolidColorBrush x:Key="Theme.Status.Up.Foreground" Color="#047857"/>
        <SolidColorBrush x:Key="Theme.Status.Down.Background" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="Theme.Status.Down.Foreground" Color="#B91C1C"/>
        <SolidColorBrush x:Key="Theme.Status.Warning.Background" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Theme.Status.Warning.Foreground" Color="#B45309"/>
        <SolidColorBrush x:Key="Theme.Status.Error.Background" Color="#FFEDD5"/>
        <SolidColorBrush x:Key="Theme.Status.Error.Foreground" Color="#C2410C"/>
        <SolidColorBrush x:Key="Theme.Status.Info.Background" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="Theme.Status.Info.Foreground" Color="#0369A1"/>

        <SolidColorBrush x:Key="Theme.Badge.Background" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="Theme.Hover" Color="#0D0EA5E9"/>

        <sys:Double x:Key="Theme.Card.Blur">0</sys:Double>
    </ResourceDictionary>

