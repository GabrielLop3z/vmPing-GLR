<Window x:Class="vmPing.UI.PortScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escáner de Puertos - vmPing GLR"
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Window.Foreground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Escáner de Puertos TCP" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
            <TextBlock Text="Verifique la apertura de puertos en un host o dirección IP específica" FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}"/>
        </StackPanel>

        <!-- Inputs Card -->
        <Border Grid.Row="1" Background="{DynamicResource Theme.Card.Background}" BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Host -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,10">
                    <TextBlock Text="Host / IP" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtHost" Padding="8,6" FontSize="13" Background="{DynamicResource Theme.Badge.Background}" Foreground="{DynamicResource Theme.Text.Primary}" BorderThickness="1" BorderBrush="{DynamicResource Theme.Card.Border}"/>
                </StackPanel>

                <!-- Range / Presets -->
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,10,10">
                    <TextBlock Text="Puerto Inicial" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtStartPort" Text="1" Padding="8,6" FontSize="13" Background="{DynamicResource Theme.Badge.Background}" Foreground="{DynamicResource Theme.Text.Primary}" BorderThickness="1" BorderBrush="{DynamicResource Theme.Card.Border}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,10,10">
                    <TextBlock Text="Puerto Final" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtEndPort" Text="1024" Padding="8,6" FontSize="13" Background="{DynamicResource Theme.Badge.Background}" Foreground="{DynamicResource Theme.Text.Primary}" BorderThickness="1" BorderBrush="{DynamicResource Theme.Card.Border}"/>
                </StackPanel>

                <!-- Action Button -->
                <Button x:Name="btnScan" Grid.Column="3" Grid.Row="0" Content="Escanear" Padding="20,8" VerticalAlignment="Bottom" Margin="0,0,0,10"
                        Background="{DynamicResource Theme.Accent}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnScan_Click"/>

                <!-- Quick Preset Dropdown -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="Preajuste:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cmbPresets" Width="260" Padding="6,4" SelectionChanged="CmbPresets_SelectionChanged"
                              Background="{DynamicResource Theme.Badge.Background}" Foreground="{DynamicResource Theme.Text.Primary}">
                        <ComboBoxItem Content="Puertos Comunes (1 - 1024)" IsSelected="True"/>
                        <ComboBoxItem Content="Servicios Web (80, 443, 8080, 8443)"/>
                        <ComboBoxItem Content="Acceso Remoto (22, 23, 3389, 5900)"/>
                        <ComboBoxItem Content="Base de Datos (1433, 1521, 3306, 5432, 27017)"/>
                        <ComboBoxItem Content="Correo (25, 110, 143, 465, 587, 993)"/>
                    </ComboBox>
                    <CheckBox x:Name="chkOpenOnly" Content="Solo abiertos" IsChecked="True" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="{DynamicResource Theme.Text.Primary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress bar -->
        <ProgressBar x:Name="progressBar" Grid.Row="2" Height="6" Margin="0,0,0,10" Visibility="Collapsed" Background="{DynamicResource Theme.Badge.Background}" Foreground="{DynamicResource Theme.Accent}"/>

        <!-- Results Grid -->
        <DataGrid x:Name="dgResults" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Theme.Card.Border}"
                  Background="{DynamicResource Theme.Card.Background}" Foreground="{DynamicResource Theme.Text.Primary}" BorderThickness="1" BorderBrush="{DynamicResource Theme.Card.Border}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Puerto" Binding="{Binding Port}" Width="90"/>
                <DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="160"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="110"/>
                <DataGridTextColumn Header="Tiempo (ms)" Binding="{Binding ResponseTimeMs}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <StatusBar Grid.Row="4" Background="Transparent" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Listo" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
