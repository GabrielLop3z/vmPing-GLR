<Window x:Class="vmPing.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="vmPing - Actualización disponible"
        UseLayoutRounding="True"
        Width="560"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        ShowInTaskbar="False"
        Topmost="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="16" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Theme.Window.GlassBackground}"
            BorderBrush="{DynamicResource Theme.Card.Border}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Content -->
            <StackPanel Grid.Row="0" Margin="24,24,24,20">

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="24" Background="#DBEAFE" VerticalAlignment="Top">
                        <Image Source="{StaticResource icon.cloud-download}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Width="24"
                               Height="24"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,2,0,0">
                        <TextBlock x:Name="HeaderText"
                                   Text="Actualización disponible"
                                   Foreground="{DynamicResource Theme.Text.Primary}"
                                   FontSize="18"
                                   FontFamily="Segoe UI, Tahoma, Arial"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="SubHeaderText"
                                   FontSize="13"
                                   FontFamily="Segoe UI, Tahoma, Arial"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource Theme.Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Text="Hay una nueva versión de vmPing GLR."/>
                    </StackPanel>
                </Grid>

                <!-- Version info -->
                <Border Margin="0,20,0,0"
                        Background="{DynamicResource Theme.Card.Background}"
                        BorderBrush="{DynamicResource Theme.Card.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Versión actual"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Theme.Text.Secondary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CurrentVersionText"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.Text.Primary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="&#x2192;"
                                   FontSize="18"
                                   Foreground="{DynamicResource Theme.Text.Secondary}"
                                   VerticalAlignment="Center"
                                   Margin="24,0"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Nueva versión"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Theme.Text.Secondary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NewVersionText"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Changelog -->
                <Border x:Name="ChangelogContainer"
                        Visibility="Collapsed"
                        Margin="0,16,0,0"
                        Background="{DynamicResource Theme.Card.Background}"
                        BorderBrush="{DynamicResource Theme.Card.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Novedades de esta versión"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Theme.Text.Secondary}"/>
                        <TextBox x:Name="ChangelogBox"
                                 Margin="0,8,0,0"
                                 FontSize="12"
                                 FontFamily="Segoe UI, Tahoma, Arial"
                                 Foreground="{DynamicResource Theme.Text.Primary}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxHeight="140"
                                 Focusable="False"/>
                    </StackPanel>
                </Border>

                <!-- Download progress -->
                <StackPanel x:Name="ProgressPanel"
                            Visibility="Collapsed"
                            Margin="0,16,0,0">
                    <TextBlock x:Name="ProgressStatusText"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.Text.Secondary}"
                               Text="Descargando actualización..."/>
                    <ProgressBar x:Name="DownloadProgressBar"
                                 Margin="0,8,0,0"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Foreground="#2563EB"
                                 Background="{DynamicResource Theme.Card.Border}"/>
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <Border Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Theme.Card.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="16">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="SkipButton"
                            Style="{StaticResource ButtonStandardStyle}"
                            Width="Auto"
                            Height="32"
                            Padding="14,6"
                            Content="Omitir esta versión"
                            Click="SkipButton_Click"/>
                    <Button x:Name="RemindButton"
                            Style="{StaticResource ButtonStandardStyle}"
                            Margin="10,0,0,0"
                            Width="Auto"
                            Height="32"
                            Padding="14,6"
                            Content="Recordar más tarde"
                            Click="RemindButton_Click"/>
                    <Button x:Name="UpdateButton"
                            Style="{StaticResource ButtonPrimaryStyle}"
                            Margin="10,0,0,0"
                            Width="Auto"
                            Height="32"
                            Padding="20,6"
                            IsDefault="True"
                            Content="Actualizar ahora"
                            Click="UpdateButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
