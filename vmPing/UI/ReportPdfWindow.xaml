<Window x:Class="vmPing.UI.ReportPdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporte empresarial PDF - vmPing GLR"
        Height="640" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Window.Foreground}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Reporte empresarial de disponibilidad"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource Theme.Text.Primary}"/>
            <TextBlock Text="Genera un PDF con equipos OK, disponibilidad, errores, horarios de fallo, inestabilidad y bitacora por hora."
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource Theme.Card.Background}"
                BorderBrush="{DynamicResource Theme.Card.Border}"
                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtFrom" Margin="0,0,16,6" Padding="5"
                         ToolTip="Formato: dd/MM/yyyy HH:mm"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Hasta:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtTo" Margin="0,0,0,6" Padding="5"
                         ToolTip="Formato: dd/MM/yyyy HH:mm"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,2,0,8">
                    <Button Content="Ultima hora" Padding="10,4" Margin="0,0,8,0" Click="QuickLastHour_Click"/>
                    <Button Content="Hoy 07:00 - 16:59" Padding="10,4" Margin="0,0,8,0" Click="QuickToday_Click"/>
                    <Button Content="Ayer 07:00 - 16:59" Padding="10,4" Margin="0,0,8,0" Click="QuickYesterday_Click"/>
                    <Button Content="Ultimos 7 dias 07:00 - 16:59" Padding="10,4" Click="QuickWeek_Click"/>
                </StackPanel>

                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="chkOnlyWorkHours"
                          Content="Filtrar solo horario laboral" IsChecked="True" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="Desde hora:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtWorkStartHour" Width="46" Padding="4" Text="7"/>
                    <TextBlock Text="Hasta hora:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="txtWorkEndHour" Width="46" Padding="4" Text="16"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource Theme.Card.Background}"
                BorderBrush="{DynamicResource Theme.Card.Border}"
                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Entrega por correo" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{DynamicResource Theme.Text.Primary}"/>
                <CheckBox x:Name="chkSendEmail" Content="Enviar el PDF por correo al generar"
                          Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Destinatarios:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtRecipients" Width="480" Padding="5"
                             ToolTip="Separe varias direcciones con punto y coma. Se toma de Opciones > Reportes si se deja vacio."/>
                </StackPanel>
                <TextBlock Text="El servidor SMTP y las credenciales se configuran en Opciones > Reportes."
                           FontSize="11" Margin="0,8,0,0"
                           Foreground="{DynamicResource Theme.Text.Muted}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource Theme.Card.Background}"
                BorderBrush="{DynamicResource Theme.Card.Border}"
                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtSummary" TextWrapping="Wrap"
                           Foreground="{DynamicResource Theme.Text.Primary}"
                           Text="Seleccione el periodo y genere el reporte."/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button x:Name="btnOpenPdf" Content="Abrir PDF" Padding="14,7" Margin="0,0,8,0"
                    Click="BtnOpenPdf_Click" IsEnabled="False"/>
            <Button x:Name="btnOpenFolder" Content="Abrir carpeta" Padding="14,7" Margin="0,0,8,0"
                    Click="BtnOpenFolder_Click" IsEnabled="False"/>
            <Button x:Name="btnGenerate" Content="Generar PDF" Padding="16,7" Margin="0,0,8,0"
                    Background="{DynamicResource Theme.Status.Info.Foreground}" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold" Click="BtnGenerate_Click"/>
            <Button x:Name="btnGenerateSend" Content="Generar y enviar" Padding="16,7"
                    Background="{DynamicResource Theme.Accent}" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold" Click="BtnGenerateSend_Click"/>
        </StackPanel>

        <StatusBar Grid.Row="5" Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Listo" FontSize="11"
                           Foreground="{DynamicResource Theme.Text.Secondary}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
