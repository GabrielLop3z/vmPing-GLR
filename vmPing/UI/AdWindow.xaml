<Window x:Class="vmPing.UI.AdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Active Directory - vmPing GLR"
        Height="680" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Window.Foreground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Active Directory" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
            <TextBlock x:Name="lblSubtitle" Text="Consultando el dominio..." FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource Theme.Card.Background}" BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnRefresh" Content="Actualizar" Padding="14,6" Margin="0,0,8,0"
                            Background="{DynamicResource Theme.Accent}" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Click="BtnRefresh_Click"/>
                    <Button x:Name="btnExportExcel" Content="Exportar Excel" Padding="14,6" Margin="0,0,8,0"
                            Background="{DynamicResource Theme.Badge.Background}" BorderBrush="{DynamicResource Theme.Card.Border}"
                            BorderThickness="1" Foreground="{DynamicResource Theme.Text.Primary}" Cursor="Hand" Click="BtnExportExcel_Click"/>
                    <Button x:Name="btnExportHtml" Content="Exportar HTML" Padding="14,6"
                            Background="{DynamicResource Theme.Badge.Background}" BorderBrush="{DynamicResource Theme.Card.Border}"
                            BorderThickness="1" Foreground="{DynamicResource Theme.Text.Primary}" Cursor="Hand" Click="BtnExportHtml_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Filtro:" FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtFilter" Width="280" Padding="6,4"
                             Background="{DynamicResource Theme.Badge.Background}" Foreground="{DynamicResource Theme.Text.Primary}"
                             BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                             TextChanged="TxtFilter_TextChanged"/>
                </StackPanel>

                <TextBlock x:Name="lblCount" Grid.Column="2" FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Results -->
        <TabControl Grid.Row="2">
            <TabItem Header="Computadoras">
                <Border Background="{DynamicResource Theme.Card.Background}" BorderBrush="{DynamicResource Theme.Card.Border}"
                        BorderThickness="1" CornerRadius="10" Padding="0">
                    <DataGrid x:Name="dgComputers" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="DgComputers_MouseDoubleClick"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="{DynamicResource Theme.Card.Background}"
                              AlternatingRowBackground="{DynamicResource Theme.Badge.Background}"
                              Foreground="{DynamicResource Theme.Text.Primary}"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Resources>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Background" Value="{DynamicResource Theme.Badge.Background}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Card.Border}"/>
                            </Style>
                            <Style TargetType="{x:Type DataGridRow}">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Equipo" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="DNS" Binding="{Binding DnsHostName}" Width="200"/>
                            <DataGridTextColumn Header="Sistema Operativo" Binding="{Binding OperatingSystem}" Width="190"/>
                            <DataGridTextColumn Header="OU" Binding="{Binding OuPath}" Width="200"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="160"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="110"/>
                            <DataGridTextColumn Header="Último Logon" Binding="{Binding LastLogonText}" Width="130"/>
                            <DataGridTextColumn Header="Inventario" Binding="{Binding InventoryStateText}" Width="110"/>
                            <DataGridTextColumn Header="Serie" Binding="{Binding Serials}" Width="120"/>
                            <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="140"/>
                            <DataGridTextColumn Header="RAM" Binding="{Binding RamText}" Width="90"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding IpText}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="Usuarios">
                <Border Background="{DynamicResource Theme.Card.Background}" BorderBrush="{DynamicResource Theme.Card.Border}"
                        BorderThickness="1" CornerRadius="10" Padding="0">
                    <DataGrid x:Name="dgUsers" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="{DynamicResource Theme.Card.Background}"
                              AlternatingRowBackground="{DynamicResource Theme.Badge.Background}"
                              Foreground="{DynamicResource Theme.Text.Primary}"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Resources>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Background" Value="{DynamicResource Theme.Badge.Background}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Card.Border}"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding DisplayName}" Width="220"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding SamAccountName}" Width="150"/>
                            <DataGridTextColumn Header="OU" Binding="{Binding OuPath}" Width="220"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="200"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="100"/>
                            <DataGridTextColumn Header="Último Logon" Binding="{Binding LastLogonText}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status -->
        <StatusBar Grid.Row="3" Background="Transparent" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Doble clic en una computadora para ver el detalle del inventario (si está correlacionada)." FontSize="11"
                           Foreground="{DynamicResource Theme.Text.Secondary}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>