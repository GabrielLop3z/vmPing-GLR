<Window x:Class="vmPing.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard de Monitoreo - vmPing GLR"
        Height="860" Width="1100"
        MinHeight="720" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Window.Foreground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.3*" MinHeight="190"/>
            <RowDefinition Height="1*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Dashboard de Monitoreo" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                <TextBlock x:Name="lblSubtitle" Text="En vivo - actualización cada 2 segundos" FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnPause" Content="Pausar" Padding="12,6" Margin="0,0,8,0"
                        Style="{StaticResource ButtonStandardStyle}" Click="BtnPause_Click"/>
                <Button Content="Exportar CSV" Padding="12,6" Margin="0,0,8,0"
                        Style="{StaticResource ButtonStandardStyle}" Click="BtnExportCsv_Click"/>
                <Button Content="Exportar HTML" Padding="12,6"
                        Style="{StaticResource ButtonPrimaryStyle}" Click="BtnExportHtml_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Row 1: KPI Cards -->
        <Border Grid.Row="1" Background="{DynamicResource Theme.Card.Background}"
                BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Total Hosts -->
                <Border Grid.Column="0" CornerRadius="8" Padding="12" Margin="0,0,8,0"
                        Background="{DynamicResource Theme.Badge.Background}">
                    <StackPanel>
                        <TextBlock Text="TOTAL HOSTS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,4"/>
                        <Viewbox Height="34" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                            <TextBlock x:Name="kpiTotal" Text="0" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.Text.Primary}"/>
                        </Viewbox>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Up -->
                <Border Grid.Column="1" CornerRadius="8" Padding="12" Margin="4,0"
                        Background="{DynamicResource Theme.Badge.Background}">
                    <StackPanel>
                        <TextBlock Text="EN LINEA" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,4"/>
                        <Viewbox Height="34" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                            <TextBlock x:Name="kpiUp" Text="0" FontSize="28" FontWeight="Bold"
                                       Foreground="#16A34A"/>
                        </Viewbox>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Down -->
                <Border Grid.Column="2" CornerRadius="8" Padding="12" Margin="4,0"
                        Background="{DynamicResource Theme.Badge.Background}">
                    <StackPanel>
                        <TextBlock Text="CAIDOS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,4"/>
                        <Viewbox Height="34" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                            <TextBlock x:Name="kpiDown" Text="0" FontSize="28" FontWeight="Bold"
                                       Foreground="#DC2626"/>
                        </Viewbox>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Error -->
                <Border Grid.Column="3" CornerRadius="8" Padding="12" Margin="4,0"
                        Background="{DynamicResource Theme.Badge.Background}">
                    <StackPanel>
                        <TextBlock Text="ERROR" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,4"/>
                        <Viewbox Height="34" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                            <TextBlock x:Name="kpiError" Text="0" FontSize="28" FontWeight="Bold"
                                       Foreground="#EA580C"/>
                        </Viewbox>
                    </StackPanel>
                </Border>

                <!-- KPI 5: Availability % -->
                <Border Grid.Column="4" CornerRadius="8" Padding="12" Margin="4,0"
                        Background="{DynamicResource Theme.Badge.Background}">
                    <StackPanel>
                        <TextBlock Text="DISPONIBILIDAD" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,4"/>
                        <Viewbox Height="34" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                            <TextBlock x:Name="kpiAvailability" Text="--" FontSize="28" FontWeight="Bold"
                                       Foreground="#2563EB"/>
                        </Viewbox>
                    </StackPanel>
                </Border>

                <!-- KPI 6: Avg RTT -->
                <Border Grid.Column="5" CornerRadius="8" Padding="12" Margin="8,0,0,0"
                        Background="{DynamicResource Theme.Badge.Background}">
                    <StackPanel>
                        <TextBlock Text="RTT PROMEDIO" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,4"/>
                        <Viewbox Height="34" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                            <TextBlock x:Name="kpiAvgRtt" Text="--" FontSize="28" FontWeight="Bold"
                                       Foreground="#7C3AED"/>
                        </Viewbox>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Row 2: Insights (percentiles, hotspots and trend) -->
        <Border Grid.Row="2" Background="{DynamicResource Theme.Card.Background}"
                BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="2,0,12,0">
                    <TextBlock Text="P95 LATENCIA (SESION)" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Text.Muted}"/>
                    <TextBlock x:Name="insightP95" Text="--" FontSize="20" FontWeight="Bold"
                               Foreground="#7C3AED" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="insightP95Detail" Text="Sin muestras" FontSize="10"
                               Foreground="{DynamicResource Theme.Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0">
                    <TextBlock Text="HOST MAS INESTABLE" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Text.Muted}"/>
                    <TextBlock x:Name="insightWorstHost" Text="--" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="insightWorstDetail" Text="Sin datos" FontSize="10"
                               Foreground="{DynamicResource Theme.Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="12,0">
                    <TextBlock Text="HORA CRITICA (24 H)" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Text.Muted}"/>
                    <TextBlock x:Name="insightCriticalHour" Text="--" FontSize="20" FontWeight="Bold"
                               Foreground="#DC2626"/>
                    <TextBlock x:Name="insightCriticalDetail" Text="Sin caidas" FontSize="10"
                               Foreground="{DynamicResource Theme.Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="12,0,2,0">
                    <TextBlock Text="TENDENCIA 15 MIN" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Text.Muted}"/>
                    <TextBlock x:Name="insightTrend" Text="--" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Text.Primary}"/>
                    <TextBlock x:Name="insightTrendDetail" Text="Sin datos suficientes" FontSize="10"
                               Foreground="{DynamicResource Theme.Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 3: Main content (Grid + Right panel) -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="350"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="0.9*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Host Status Grid -->
            <Border Grid.Column="0" Background="{DynamicResource Theme.Card.Background}"
                    BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Estado de Hosts" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Text.Primary}" Margin="8,6,8,8"/>
                    <DataGrid x:Name="dgHosts" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource Theme.Card.Border}"
                              Background="Transparent" Foreground="{DynamicResource Theme.Text.Primary}"
                              BorderThickness="0" SelectionMode="Single" SelectionChanged="DgHosts_SelectionChanged"
                              CanUserSortColumns="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Host" Binding="{Binding Hostname}" Width="*" MinWidth="92" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="*" MinWidth="62" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="72" IsReadOnly="True"/>
                            <DataGridTextColumn Header="RTT" Binding="{Binding CurrentRtt, StringFormat={}{0:F0}}" Width="48" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Avg" Binding="{Binding AvgRtt, StringFormat={}{0:F1}}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding MaxRtt, StringFormat={}{0:F0}}" Width="46" IsReadOnly="True"/>
                            <DataGridTextColumn Header="P95" Binding="{Binding P95Rtt, StringFormat={}{0:F0}}" Width="46" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Loss%" Binding="{Binding LossPct, StringFormat={}{0:F1}}" Width="52" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Caidas" Binding="{Binding DownEvents}" Width="58" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Right panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="100"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="1*" MinHeight="90"/>
                </Grid.RowDefinitions>

                <!-- RTT Chart -->
                <Border Grid.Row="0" Background="{DynamicResource Theme.Card.Background}"
                        BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                        CornerRadius="10" Padding="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,4,4,6">
                            <TextBlock Text="RTT en Tiempo Real" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Text.Primary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblChartHost" Text="" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        </DockPanel>
                        <Border x:Name="chartBorder" Background="{DynamicResource Theme.Badge.Background}"
                                CornerRadius="6" Padding="4">
                            <Canvas x:Name="rttCanvas" ClipToBounds="True"/>
                        </Border>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"/>

                <!-- Availability Heatmap -->
                <Border Grid.Row="2" Background="{DynamicResource Theme.Card.Background}"
                        BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                        CornerRadius="10" Padding="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,4,4,6">
                            <TextBlock Text="Mapa de Disponibilidad" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Text.Primary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblHeatmapRange" Text="Ultimos 60 min" FontSize="11"
                                       Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        </DockPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="heatmapPanel" Orientation="Vertical"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Row 4: Events timeline + Analysis tabs -->
        <Border Grid.Row="4" Background="{DynamicResource Theme.Card.Background}"
                BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                CornerRadius="10" Padding="8" Margin="0,0,0,12">
            <TabControl x:Name="DashboardTabs" Background="Transparent" BorderThickness="0"
                        SelectionChanged="DashboardTabs_SelectionChanged">
                <TabItem Header="Eventos">
                    <DockPanel Margin="4,0,0,0">
                        <TextBlock x:Name="lblEventCount" DockPanel.Dock="Top" Text="0 eventos" FontSize="11"
                                   Foreground="{DynamicResource Theme.Text.Secondary}"
                                   HorizontalAlignment="Right" Margin="0,0,4,4"/>
                        <ScrollViewer x:Name="eventScroller" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="eventList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="0,0,0,1" Padding="4,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="11"
                                                           Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Host}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Theme.Text.Primary}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                <Border Grid.Column="2" Background="{Binding StatusBadgeBg}" CornerRadius="8"
                                                        Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Analisis">
                    <TabItem.Resources>
                        <Style TargetType="TextBlock" x:Key="ChartTitle">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="ChartCaption">
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Muted}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </TabItem.Resources>
                    <Grid Margin="4,2,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Top packet loss bars -->
                        <Border Grid.Column="0" Margin="0,0,6,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource ChartTitle}" Text="Top perdidas de paquetes (%)"/>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource ChartCaption}"
                                           Text="Hosts con mayor porcentaje de perdida en la sesion."/>
                                <Canvas x:Name="topLossCanvas" ClipToBounds="True" Margin="0,4,0,4"/>
                            </DockPanel>
                        </Border>

                        <!-- Latency histogram -->
                        <Border Grid.Column="1" Margin="6,0,6,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource ChartTitle}" Text="Distribucion de latencia"/>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource ChartCaption}" x:Name="lblHistogramCaption"
                                           Text="Muestras agrupadas por rango de RTT."/>
                                <Canvas x:Name="latencyCanvas" ClipToBounds="True" Margin="0,4,0,4"/>
                            </DockPanel>
                        </Border>

                        <!-- Availability donut -->
                        <Border Grid.Column="2" Margin="6,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource ChartTitle}" Text="Disponibilidad global"/>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource ChartCaption}" x:Name="lblDonutCaption"
                                           Text="Recibidos vs. perdidos."/>
                                <Canvas x:Name="donutCanvas" ClipToBounds="True" Margin="0,4,0,4"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Row 5: Footer -->
        <DockPanel Grid.Row="5">
            <TextBlock x:Name="lblFooter" Text="" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="vmPing GLR Dashboard" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
