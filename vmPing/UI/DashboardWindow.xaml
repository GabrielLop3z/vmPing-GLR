<Window x:Class="vmPing.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard de Monitoreo - vmPing GLR"
        Height="750" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Window.Foreground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Dashboard de Monitoreo" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                <TextBlock x:Name="lblSubtitle" Text="En vivo - actualización cada 2 segundos" FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnPause" Content="Pausar" Padding="12,6" Margin="0,0,8,0"
                        Style="{StaticResource ButtonStandardStyle}" Click="BtnPause_Click"/>
                <Button Content="Exportar HTML" Padding="12,6"
                        Style="{StaticResource ButtonPrimaryStyle}" Click="BtnExportHtml_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Row 1: KPI Cards -->
        <Border Grid.Row="1" Background="{DynamicResource Theme.Card.Background}"
                BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Total Hosts -->
                <Border Grid.Column="0" CornerRadius="8" Padding="12" Margin="0,0,8,0"
                        Background="{DynamicResource Theme.Badge.Background}">
                    <StackPanel>
                        <TextBlock Text="TOTAL HOSTS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="kpiTotal" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Primary}"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Up -->
                <Border Grid.Column="1" CornerRadius="8" Padding="12" Margin="4,0"
                        Background="{DynamicResource Theme.Badge.Background}">
                    <StackPanel>
                        <TextBlock Text="EN LINEA" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="kpiUp" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Down -->
                <Border Grid.Column="2" CornerRadius="8" Padding="12" Margin="4,0"
                        Background="{DynamicResource Theme.Badge.Background}">
                    <StackPanel>
                        <TextBlock Text="CAIDOS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="kpiDown" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="#DC2626"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Error -->
                <Border Grid.Column="3" CornerRadius="8" Padding="12" Margin="4,0"
                        Background="{DynamicResource Theme.Badge.Background}">
                    <StackPanel>
                        <TextBlock Text="ERROR" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="kpiError" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="#EA580C"/>
                    </StackPanel>
                </Border>

                <!-- KPI 5: Availability % -->
                <Border Grid.Column="4" CornerRadius="8" Padding="12" Margin="4,0"
                        Background="{DynamicResource Theme.Badge.Background}">
                    <StackPanel>
                        <TextBlock Text="DISPONIBILIDAD" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="kpiAvailability" Text="--" FontSize="28" FontWeight="Bold"
                                   Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <!-- KPI 6: Avg RTT -->
                <Border Grid.Column="5" CornerRadius="8" Padding="12" Margin="8,0,0,0"
                        Background="{DynamicResource Theme.Badge.Background}">
                    <StackPanel>
                        <TextBlock Text="RTT PROMEDIO" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="kpiAvgRtt" Text="--" FontSize="28" FontWeight="Bold"
                                   Foreground="#7C3AED"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Row 2: Main content (Grid + Right panel) -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="350"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Host Status Grid -->
            <Border Grid.Column="0" Background="{DynamicResource Theme.Card.Background}"
                    BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Estado de Hosts" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Text.Primary}" Margin="8,6,8,8"/>
                    <DataGrid x:Name="dgHosts" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource Theme.Card.Border}"
                              Background="Transparent" Foreground="{DynamicResource Theme.Text.Primary}"
                              BorderThickness="0" SelectionMode="Single" SelectionChanged="DgHosts_SelectionChanged"
                              CanUserSortColumns="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Host" Binding="{Binding Hostname}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="RTT" Binding="{Binding CurrentRtt, StringFormat={}{0:F0}}" Width="55" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding MinRtt, StringFormat={}{0:F0}}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Avg" Binding="{Binding AvgRtt, StringFormat={}{0:F1}}" Width="55" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding MaxRtt, StringFormat={}{0:F0}}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Loss%" Binding="{Binding LossPct, StringFormat={}{0:F1}}" Width="55" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Down#" Binding="{Binding DownEvents}" Width="50" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Right panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="180"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="1*" MinHeight="120"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="1*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- RTT Chart -->
                <Border Grid.Row="0" Background="{DynamicResource Theme.Card.Background}"
                        BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                        CornerRadius="10" Padding="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,4,4,6">
                            <TextBlock Text="RTT en Tiempo Real" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Text.Primary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblChartHost" Text="" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        </DockPanel>
                        <Border x:Name="chartBorder" Background="{DynamicResource Theme.Badge.Background}"
                                CornerRadius="6" Padding="4">
                            <Canvas x:Name="rttCanvas" ClipToBounds="True"/>
                        </Border>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"/>

                <!-- Availability Heatmap -->
                <Border Grid.Row="2" Background="{DynamicResource Theme.Card.Background}"
                        BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                        CornerRadius="10" Padding="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,4,4,6">
                            <TextBlock Text="Mapa de Disponibilidad" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Text.Primary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblHeatmapRange" Text="Ultimos 60 min" FontSize="11"
                                       Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        </DockPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="heatmapPanel" Orientation="Vertical"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"/>

                <!-- Health Mini Cards -->
                <Border Grid.Row="4" Background="{DynamicResource Theme.Card.Background}"
                        BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                        CornerRadius="10" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Salud de Red" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Text.Primary}" Margin="4,4,4,6"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="healthPanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Row 3: Event Timeline -->
        <Border Grid.Row="3" Background="{DynamicResource Theme.Card.Background}"
                BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                CornerRadius="10" Padding="8" Margin="0,0,0,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,4,4,6">
                    <TextBlock Text="Timeline de Eventos" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Text.Primary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblEventCount" Text="0 eventos" FontSize="11"
                               Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,4,0"/>
                </DockPanel>
                <ScrollViewer x:Name="eventScroller" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                    <ItemsControl x:Name="eventList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Row 4: Footer -->
        <DockPanel Grid.Row="4">
            <TextBlock x:Name="lblFooter" Text="" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="vmPing GLR Dashboard" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
