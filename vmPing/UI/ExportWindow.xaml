<Window x:Class="vmPing.UI.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar Reporte - vmPing GLR"
        Height="700" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Window.Foreground}"
        Loaded="Window_Loaded">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Exportar Reporte de Monitoreo" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
            <TextBlock x:Name="lblSubtitle" Text="Historial de conexión por host: identifica cuáles presentan problemas y cuáles no." FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource Theme.Card.Background}" BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Rango:" FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="rbAll" GroupName="Range" Content="Todo el monitoreo" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"
                                 Foreground="{DynamicResource Theme.Text.Primary}" Checked="Range_Changed"/>
                    <RadioButton x:Name="rb30Min" GroupName="Range" Content="Últimos 30 min" VerticalAlignment="Center" Margin="0,0,16,0"
                                 Foreground="{DynamicResource Theme.Text.Primary}" Checked="Range_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnExportExcel" Content="Exportar Excel" Padding="14,6" Margin="0,0,8,0"
                            Background="{DynamicResource Theme.Accent}" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Click="BtnExportExcel_Click"/>
                    <Button x:Name="btnExportHtml" Content="Exportar HTML" Padding="14,6" Margin="0,0,8,0"
                            Background="{DynamicResource Theme.Badge.Background}" BorderBrush="{DynamicResource Theme.Card.Border}"
                            BorderThickness="1" Foreground="{DynamicResource Theme.Text.Primary}" Cursor="Hand" Click="BtnExportHtml_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Legend -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Border Width="12" Height="12" CornerRadius="3" Background="#1A10B981" BorderBrush="#10B981" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="Bien (0% pérdida)" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Border Width="12" Height="12" CornerRadius="3" Background="#26F59E0B" BorderBrush="#F59E0B" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="Intermitente" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Border Width="12" Height="12" CornerRadius="3" Background="#26EF4444" BorderBrush="#EF4444" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="Fallando" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="12" Height="12" CornerRadius="3" Background="#334B5563" BorderBrush="#64748B" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="Sin datos" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Results -->
        <Border Grid.Row="2" Background="{DynamicResource Theme.Card.Background}" BorderBrush="{DynamicResource Theme.Card.Border}"
                BorderThickness="1" CornerRadius="10" Padding="0" Margin="0,0,0,8">
            <DataGrid x:Name="dgExport" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="{DynamicResource Theme.Card.Background}"
                      AlternatingRowBackground="{DynamicResource Theme.Badge.Background}"
                      Foreground="{DynamicResource Theme.Text.Primary}"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="{DynamicResource Theme.Badge.Background}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Card.Border}"/>
                    </Style>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Classification}" Value="Bien">
                                <Setter Property="Background" Value="#1A10B981"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Classification}" Value="Intermitente">
                                <Setter Property="Background" Value="#26F59E0B"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Classification}" Value="Fallando">
                                <Setter Property="Background" Value="#26EF4444"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Classification}" Value="Sin datos">
                                <Setter Property="Background" Value="#334B5563"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="200"/>
                    <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="150"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding CurrentStatus}" Width="110"/>
                    <DataGridTextColumn Header="Clasificación" Binding="{Binding Classification}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Enviados" Binding="{Binding Sent}" Width="90"/>
                    <DataGridTextColumn Header="Recibidos" Binding="{Binding Received}" Width="90"/>
                    <DataGridTextColumn Header="Perdidos" Binding="{Binding Lost}" Width="90"/>
                    <DataGridTextColumn Header="% Pérdida" Binding="{Binding LossPct}" Width="90"/>
                    <DataGridTextColumn Header="Min RTT (ms)" Binding="{Binding MinRtt}" Width="110"/>
                    <DataGridTextColumn Header="Prom RTT (ms)" Binding="{Binding AvgRtt}" Width="110"/>
                    <DataGridTextColumn Header="Max RTT (ms)" Binding="{Binding MaxRtt}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status -->
        <StatusBar Grid.Row="3" Background="Transparent" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Selecciona un rango y exporta el reporte." FontSize="11"
                           Foreground="{DynamicResource Theme.Text.Secondary}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
