                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                     <TextBlock Text="Añadir Host" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource Theme.Text.Primary}"/>
                     
                     <TextBlock Text="Hostname / IP" Foreground="{DynamicResource Theme.Text.Secondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                     <TextBox Name="txtAddHostname" Padding="10" FontSize="14" Margin="0,0,0,15" Background="{DynamicResource Theme.Badge.Background}" BorderThickness="0" TextChanged="AddHostname_TextChanged"/>
                     
                     <TextBlock Text="Alias (Opcional)" Foreground="{DynamicResource Theme.Text.Secondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
