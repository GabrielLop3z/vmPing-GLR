<Window x:Class="vmPing.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:classes="clr-namespace:vmPing.Classes"
        xmlns:c="clr-namespace:vmPing.Controls"
        xmlns:resource="clr-namespace:vmPing.Properties"
        Title="vmPing GLR"
        UseLayoutRounding="False"
        Width="800"
        MinHeight="200"
        MinWidth="350"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        ContentRendered="Window_ContentRendered"
        IsVisibleChanged="Window_IsVisibleChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        FontSize="14">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="10" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Override default context menu animation: set to no animation -->
        <PopupAnimation x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>

        <!-- Template for hostname textbox -->
        <ControlTemplate x:Key="TextBoxControlTemplate" TargetType="{x:Type TextBox}">
            <Grid>
                <Border x:Name="border"
                        CornerRadius="0"
                        SnapsToDevicePixels="True"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}">
                    <ScrollViewer x:Name="PART_ContentHost"/>
                </Border>
                <TextBlock x:Name="placeholderText"
                           Text="Introduce un nombre de host o IP"
                           Visibility="Hidden"
                           FontSize="12"
                           Opacity="0.3"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Padding="5,0,0,0"
                           IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#333388"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Text" Value=""/>
                        <Condition Property="IsKeyboardFocused" Value="True"/>
                    </MultiTrigger.Conditions>
                    <MultiTrigger.Setters>
                        <Setter Property="Visibility" TargetName="placeholderText" Value="Visible"/>
                    </MultiTrigger.Setters>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource Theme.Window.GlassBackground}"
            BorderBrush="{DynamicResource Theme.Card.Border}"
            BorderThickness="1"
            CornerRadius="{Binding Source={x:Static SystemParameters.WindowCornerRadius}}"
            ClipToBounds="True">
        <Grid>
        <DockPanel Background="Transparent">
            <!-- Custom Title Bar -->
            <Grid x:Name="TitleBarGrid" DockPanel.Dock="Top" Height="32" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="/vmPing.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="vmPing GLR" Foreground="{DynamicResource Theme.Text.Primary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="Minimize_Click" Style="{StaticResource TitleBarButtonStyle}">
                        <Path Data="M 0,0 L 10,0" Stroke="{DynamicResource Theme.Text.Primary}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,15,14,0"/>
                    </Button>
                    <Button Click="Maximize_Click" Style="{StaticResource TitleBarButtonStyle}">
                        <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{DynamicResource Theme.Text.Primary}" StrokeThickness="1" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,11"/>
                    </Button>
                    <Button Click="Close_Click" Style="{StaticResource TitleBarCloseButtonStyle}">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource Theme.Text.Primary}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,10"/>
                    </Button>
                </StackPanel>
            </Grid>
        <StatusBar x:Name="StatusBarControl" DockPanel.Dock="Bottom" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Theme.Card.Border}" Height="30">
            <StatusBarItem HorizontalAlignment="Left" Margin="10,0">
                <TextBlock Text="vmPing Pro Edition" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center" FontWeight="Medium"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" Margin="10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Developed by Ryan Smith | Optimized by " FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="&lt; Gabriel /&gt;" FontSize="11" Foreground="{DynamicResource Theme.Accent}" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Menu bar -->
        <Menu x:Name="MenuBar" DockPanel.Dock="Top"
              FontStretch="Normal"
              FontSize="13"
              Background="{DynamicResource Theme.Card.GlassBackground}"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource Theme.Card.Border}"
              SnapsToDevicePixels="True">
            <Menu.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.18" Color="#000000" RenderingBias="Performance"/>
            </Menu.Effect>
            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MenuItemStyle}"/>
            </Menu.Resources>
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch" LastChildFill="False" Background="Transparent"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            
            <!-- Menu: Add Probe -->
            <MenuItem x:Name="AddProbeMenu">
                <MenuItem.Header>
                    <AccessText Text="Añadir" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                </MenuItem.Header>
                <MenuItem.Icon>
                    <Image Source="{StaticResource icon.add}" VerticalAlignment="Center" Width="14" Height="14"/>
                </MenuItem.Icon>
            </MenuItem>

            <!-- Menu: Columns -->
            <MenuItem>
                <MenuItem.Header>
                    <AccessText Text="Columnas" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </MenuItem.Header>
                <MenuItem.Icon>
                    <Image Source="{StaticResource icon.columns-grid}" VerticalAlignment="Center" Width="14" Height="14"/>
                </MenuItem.Icon>
                <!-- Columns slider -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding ElementName=ColumnCount, Path=Value}"
                           Margin="0,0,15,0"
                           Width="30"
                           FontSize="14"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"/>
                    <Slider Name="ColumnCount"
                            Style="{DynamicResource SliderStyle}"
                            ValueChanged="ColumnCount_ValueChanged"
                            Minimum="1"
                            Maximum="10"
                            Value="3"
                            TickFrequency="1"
                            SmallChange="1"
                            TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"
                            Width="200"
                            Foreground="{DynamicResource Theme.Text.Primary}"
                            Margin="0,8"/>
                </StackPanel>
            </MenuItem>

            <!-- Menu: Save loaded favorite -->
            <MenuItem x:Name="SaveFavoriteMenu" IsEnabled="False" Click="SaveFavorite_Click">
                <MenuItem.Header>
                    <AccessText Text="Guardar" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </MenuItem.Header>
                <MenuItem.Icon>
                    <Image Source="{StaticResource icon.new-favorite}" VerticalAlignment="Center" Width="14" Height="14"/>
                </MenuItem.Icon>
            </MenuItem>

            <!-- Menu: Start/Stop All -->
            <MenuItem x:Name="StartStopMenu">
                <MenuItem.Header>
                    <AccessText Name="StartStopMenuHeader"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding Path=(classes:Probe.ActiveCount), Converter={StaticResource ProbeCountToGlobalStartStopText}}"/>
                </MenuItem.Header>
                <MenuItem.Icon>
                    <Image Name="StartStopMenuImage"
                           VerticalAlignment="Center"
                           Width="14" Height="14"
                           Source="{Binding Path=(classes:Probe.ActiveCount), Converter={StaticResource ProbeCountToGlobalStartStopIcon}}"/>
                </MenuItem.Icon>
            </MenuItem>

            <!-- Menu: Export report button (top bar) -->
            <MenuItem x:Name="ExportReportMenu"
                      Click="Export_Click"
                      DockPanel.Dock="Right"
                      Margin="4,4,0,4"
                      FontSize="13"
                      Foreground="White"
                      Background="{DynamicResource Theme.Accent}"
                      BorderBrush="{DynamicResource Theme.Accent}"
                      BorderThickness="1"
                      Template="{StaticResource TopLevelHeaderNoPaddingTemplate}">
                <MenuItem.Icon>
                    <Image Source="{StaticResource icon.file-export}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16"/>
                </MenuItem.Icon>
                <MenuItem.Header>
                    <TextBlock Text="Exportar" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="White"/>
                </MenuItem.Header>
            </MenuItem>

            <!-- Menu: Main menu dropdown (rounded button) -->
            <MenuItem x:Name="OptionsMenuButton"
                      MinWidth="120"
                      DockPanel.Dock="Right"
                      Margin="4,4,8,4"
                      FontSize="13"
                      Foreground="{DynamicResource Theme.Text.Primary}"
                      Background="{DynamicResource Theme.Badge.Background}"
                      BorderBrush="{DynamicResource Theme.Card.Border}"
                      BorderThickness="1"
                      Template="{StaticResource TopLevelHeaderNoPaddingTemplate}">
                <MenuItem.Icon>
                    <Image Source="{StaticResource icon.chevron-circle-down}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16"/>
                </MenuItem.Icon>
                <MenuItem.Header>
                    <TextBlock Text="Más" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                </MenuItem.Header>

                <!-- Menu: Font Size Slider -->
                <MenuItem>
                    <MenuItem.Header>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Tamaño de Texto" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ElementName=FontScaleSlider, Path=Value, StringFormat={}{0:P0}}" Width="40" VerticalAlignment="Center" FontSize="11"/>
                                <Slider x:Name="FontScaleSlider" Width="140" Minimum="0.8" Maximum="2.0" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=GlobalTextScale}" 
                                        TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1"/>
                            </StackPanel>
                        </StackPanel>
                    </MenuItem.Header>
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.pencil-black}" Width="16" Height="16" Opacity="0.5"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- Menu: Options -->
                <MenuItem Name="OptionsMenu"
                          Header="Opciones"
                          InputGestureText="F10">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.options}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- Menu: Status history -->
                <MenuItem Name="StatusHistoryMenu" Header="Historial de Estado" InputGestureText="F12">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.status-history}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Pantalla Completa" Name="FullScreenMenu" InputGestureText="F11">
                    <MenuItem.Icon>
                         <Image Source="{StaticResource icon.vmping-logo-simple}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Modo Compacto" Name="CompactModeMenu" InputGestureText="F9">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.columns-grid}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Mostrar/Ocultar Panel" Click="ToggleDashboard_Click">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.vmping-logo-simple}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Menu: Input addresses-->
                <MenuItem Name="MultiInputMenu" Header="Entrada Múltiple" InputGestureText="F2">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.input-addresses}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Menu: Popup alerts -->
                <MenuItem Header="Alertas Emergentes">
                    <MenuItem Name="PopupNever"
                               Header="Nunca"
                               Click="PopupNever_Click"
                               IsCheckable="True"/>
                    <MenuItem Name="PopupWhenMinimized"
                               Header="Al Minimizar"
                               Click="PopupWhenMinimized_Click"
                               IsCheckable="True"/>
                    <MenuItem Name="PopupAlways"
                               Header="Siempre"
                               Click="PopupAlways_Click"
                               IsCheckable="True"/>
                </MenuItem>
                <Separator />
                <!-- Menu: Favorite sets-->
                <MenuItem Header="Favoritos" x:Name="FavoritesMenu">
                    <MenuItem Header="Guardar Favorito" Click="CreateFavorite_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.new-favorite}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Administrar Favoritos" Click="ManageFavorites_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.favorite}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                </MenuItem>
                <!-- Menu: Aliases-->
                <MenuItem Header="Alias" x:Name="AliasesMenu">
                    <MenuItem Header="Administrar Alias" Click="ManageAliases_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.alias}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                </MenuItem>
                <Separator />
                <!-- Menu: Tools Submenu -->
                <MenuItem Header="Herramientas" x:Name="ToolsMenu">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.options}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Escáner de Puertos" Click="PortScanner_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.route}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="MTR (Ping + Ruta)" Click="Mtr_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.status-history}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Info de Red Local" Click="LocalNetworkInfo_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.info-circle}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Consulta DNS (Lookup)" Click="DnsLookup_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.question-circle}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Calculadora de Subred" Click="SubnetCalculator_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.columns-grid}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Wake on LAN (WoL)" Click="WakeOnLan_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.play}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Reportes de Hosts" Click="Reports_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.file-code}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Exportar Reporte (Excel)" Click="Export_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.file-export}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Dashboard de Monitoreo" Click="Dashboard_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.columns-grid}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Inventario de Equipos" Click="Inventory_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.info-circle}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Salud en Vivo" Click="Health_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.heart-pulse}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Active Directory" Click="Ad_Click">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource icon.server}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <Separator />
                <!-- Menu: Traceroute -->
                <MenuItem Header="Trazar Ruta" x:Name="TracerouteMenu" InputGestureText="Ctrl-T">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.route}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Menu: Flood host -->
                <MenuItem Header="Inundar Host (Flood)" x:Name="FloodHostMenu" InputGestureText="Ctrl-F">
                    <MenuItem.Icon>
                        <Image Source="/Resources/bomb-16.png" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Menu: Network Scan -->
                <MenuItem Header="Escanear Red" x:Name="NetworkScanMenu">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.input-addresses}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Menu: New instance -->
                <MenuItem Header="Nueva Instancia" x:Name="NewInstanceMenu" InputGestureText="Ctrl-N">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.vmping-logo-simple}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- Menu: Update -->
                <MenuItem Header="Buscar Actualizaciones" x:Name="UpdateMenu">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.cloud-download}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Menu: Help -->
                <MenuItem Header="Ayuda" x:Name="HelpMenu" InputGestureText="F1">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.question-circle}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Menu: Welcome -->
                <MenuItem Header="Bienvenida" x:Name="WelcomeMenu">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource icon.vmping-logo-simple}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Dashboard Section -->
        <Border DockPanel.Dock="Top" 
                Background="{DynamicResource Theme.Card.Background}" 
                BorderThickness="0,0,0,1" 
                BorderBrush="{DynamicResource Theme.Card.Border}"
                Height="90"
                Name="DashboardBorder"
                Visibility="Visible">
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Circular Health Indicator (Simulated) -->
                <Border Grid.Column="0" Background="{DynamicResource Theme.Badge.Background}" CornerRadius="12" Margin="0,0,15,0" BorderThickness="1" BorderBrush="{DynamicResource Theme.Card.Border}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Donut Chart Visualization -->
                        <Grid Grid.Column="0" Margin="15,5">
                            <Ellipse Width="50" Height="50" StrokeThickness="6" Stroke="{DynamicResource Theme.Card.Border}"/>
                            <Ellipse Width="50" Height="50" StrokeThickness="6" Stroke="{DynamicResource Theme.Accent}" StrokeDashArray="3 1" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ElementName=Dash_TotalNodes, Path=Text}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.Text.Primary}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="ESTADO GENERAL" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" FontWeight="SemiBold"/>
                            <TextBlock Text="Monitoreo Activo" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Theme.Status.Up.Foreground}" Margin="0,0,6,0"/>
                                <TextBlock Text="Sistema en línea" FontSize="11" Foreground="{DynamicResource Theme.Status.Up.Foreground}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right: Detailed Stats Cards -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active -->
                    <Border Grid.Column="0" Background="{DynamicResource Theme.Status.Up.Background}" CornerRadius="10" Margin="0,0,8,0" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource Theme.Card.Border}">
                        <DockPanel>
                            <Border Background="{DynamicResource Theme.Status.Up.Foreground}" Width="32" Height="32" CornerRadius="8" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Image Source="{StaticResource icon.check-circle-green}" Width="16" Height="16"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="ACTIVOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Status.Up.Foreground}" Opacity="0.8"/>
                                <TextBlock Name="Dash_UpNodes" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Status.Up.Foreground}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Down -->
                    <Border Grid.Column="1" Background="{DynamicResource Theme.Status.Down.Background}" CornerRadius="10" Margin="4,0,4,0" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource Theme.Card.Border}">
                        <DockPanel>
                            <Border Background="{DynamicResource Theme.Status.Down.Foreground}" Width="32" Height="32" CornerRadius="8" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Image Source="{StaticResource icon.exclamation-circle}" Width="16" Height="16"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="CAÍDOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Status.Down.Foreground}" Opacity="0.8"/>
                                <TextBlock Name="Dash_DownNodes" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Status.Down.Foreground}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Latency -->
                    <Border Grid.Column="2" Background="{DynamicResource Theme.Status.Info.Background}" CornerRadius="10" Margin="8,0,0,0" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource Theme.Card.Border}">
                        <DockPanel>
                            <Border Background="{DynamicResource Theme.Status.Info.Foreground}" Width="32" Height="32" CornerRadius="8" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Image Source="{StaticResource icon.route}" Width="16" Height="16" Opacity="0.9"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="LATENCIA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Status.Info.Foreground}" Opacity="0.8"/>
                                <TextBlock Name="Dash_AvgLatency" Text="0 ms" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Status.Info.Foreground}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    
                    <!-- Hidden total node for binding -->
                    <TextBlock Name="Dash_TotalNodes" Visibility="Collapsed" Text="0"/>
                </Grid>
            </Grid>
        </Border>


        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0">
            <ItemsControl Name="ProbeItemsControl" 
                          IsTabStop="False" 
                          Focusable="False" 
                          BorderThickness="0" 
                          Margin="4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ViewColumnCount}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1" Margin="6" CornerRadius="12" SnapsToDevicePixels="True"
                                Background="{Binding Status, Converter={StaticResource ProbeStatusToBackgroundBrushConverter}}"
                                RenderTransformOrigin="0.5,0.5"
                                MouseLeftButtonUp="Card_Click">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="5" Color="#000000" Opacity="0.1" ShadowDepth="1" Direction="270" RenderingBias="Performance"/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Border.Style>
                            <Grid Name="gridItemsControl">
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=GlobalTextScale}"
                                                    ScaleY="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=GlobalTextScale}"/>
                                </Grid.LayoutTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
    
                                <!-- Ping output section -->
                                <DockPanel AllowDrop="True" Drop="Probe_Drop">
    
                                    <!-- Ping title bar / button section -->
                                    <Grid DockPanel.Dock="Top">
                                        <Grid.Style>
                                            <Style TargetType="{x:Type Grid}">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=gridItemsControl, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Theme.Hover}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
    
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
    
                                        <!-- Alias section -->
                                        <Label Name="txtEditAlias"
                                               Content="{Binding Alias, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"
                                               Background="Transparent"
                                               FontSize="13"
                                               VerticalContentAlignment="Center"
                                               Padding="10,4"
                                               Margin="0"
                                               FontWeight="Bold"
                                               Foreground="{Binding Status, Converter={StaticResource ProbeStatusToAliasBrushConverter}}"
                                               AllowDrop="True" Drop="Probe_Drop" PreviewMouseMove="ProbeTitle_PreviewMouseMove">
                                        </Label>
    
                                        <!-- Button: Remove probe -->
                                        <Button Grid.Column="3"
                                                Padding="8,4"
                                                Background="Transparent"
                                                HorizontalAlignment="Right"
                                                IsTabStop="False"
                                                ToolTip="Cerrar"
                                                Click="RemoveProbe_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Name="controlButton_border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                                                        <Image Name="controlButton_image" Source="{StaticResource icon.window-close-black}" Width="12" Height="12" Opacity="0.6"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="controlButton_border" Property="Background" Value="{DynamicResource Theme.Status.Down.Foreground}"/>
                                                        <Setter TargetName="controlButton_image" Property="Source" Value="{StaticResource icon.window-close-white}"/>
                                                        <Setter TargetName="controlButton_image" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=gridItemsControl, Path=IsMouseOver}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
    
                                        <!-- Button: Isolated view -->
                                        <Button Grid.Column="2" Padding="8,4" Background="Transparent" Click="IsolatedView_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Name="controlButton_border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                        <Image Source="{StaticResource icon.window-restore-black}" Width="12" Height="12" Opacity="0.6"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="controlButton_border" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=gridItemsControl, Path=IsMouseOver}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
    
                                        <!-- Button: Edit alias -->
                                        <Button Grid.Column="1" Padding="8,4" Background="Transparent" Click="EditAlias_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Name="controlButton_border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                        <Image Source="{StaticResource icon.pencil-black}" Width="12" Height="12" Opacity="0.6"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="controlButton_border" Property="Background" Value="{DynamicResource Theme.Status.Up.Foreground}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=gridItemsControl, Path=IsMouseOver}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
    
                                    <!-- Ping statistics -->
                                    <Grid DockPanel.Dock="Bottom" Margin="5,0,5,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.Style>
                                            <Style TargetType="{x:Type Grid}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=Type}" Value="Ping">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Statistics.Sent}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <!-- ENV Badge -->
                                        <Border Grid.Column="0" Background="{DynamicResource Theme.Badge.Background}" CornerRadius="6" Padding="6,2" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ENV" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Statistics.Sent}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- REC Badge -->
                                        <Border Grid.Column="1" Background="{DynamicResource Theme.Status.Up.Background}" CornerRadius="6" Padding="6,2" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="REC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Theme.Status.Up.Foreground}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Statistics.Received}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Status.Up.Foreground}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- PERD Badge -->
                                        <Border Grid.Column="2" Background="{DynamicResource Theme.Status.Down.Background}" CornerRadius="6" Padding="6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="PERD" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Theme.Status.Down.Foreground}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Statistics.Lost}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Status.Down.Foreground}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
    
                                    <!-- Main Content: History and Graph layered -->
                                    <Grid>
                                        <!-- Watermark Status Icon -->
                                        <Image Width="180" Height="180" Opacity="0.1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Image.RenderTransform>
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{x:Null}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Up">
                                                            <Setter Property="Source" Value="{StaticResource icon.check-circle-green}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Down">
                                                            <Setter Property="Source" Value="{StaticResource icon.exclamation-circle}"/>
                                                            <Setter Property="Opacity" Value="1.0"/> 
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Source" Value="{StaticResource icon.exclamation-triangle}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- Latency Sparkline (Background) -->
                                        <Polyline Points="{Binding LatencyHistory, Converter={StaticResource LatencyHistoryToPointsConverter}}"
                                                  Stroke="{Binding Status, Converter={StaticResource ProbeStatusToStatisticsBrushConverter}}"
                                                  StrokeThickness="2"
                                                  Opacity="0.3"
                                                  Stretch="Fill"
                                                  VerticalAlignment="Bottom"
                                                  HorizontalAlignment="Stretch"
                                                  Height="120"
                                                  Margin="0,0,10,10"
                                                  IsHitTestVisible="False">
                                            <Polyline.Style>
                                                <Style TargetType="Polyline">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Polyline.Style>
                                        </Polyline>

                                        <!-- Ping history (Foreground) -->
                                        <c:AutoScrollListBox x:Name="History"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             Foreground="{Binding Status, Converter={StaticResource ProbeStatusToForegroundBrushConverter}}"
                                                             ItemsSource="{Binding History}"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             FontFamily="Consolas"
                                                             FontSize="{Binding Type, Converter={StaticResource ProbeTypeToFontSizeConverter}}">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                <ContentPresenter Margin="8,1"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </c:AutoScrollListBox>
                                    </Grid>
                                </DockPanel>
    
    
                                <!-- vmPing icon -->
                                <Image Source="{StaticResource icon.vmping-logo-simple}" Width="48" Height="48" IsHitTestVisible="False"
                                       Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                       Opacity="0.05" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    
                                <!-- Hostname and ping button section -->
                                <Grid Grid.Row="1" Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
    
                                    <Border Grid.ColumnSpan="4" Background="{DynamicResource Theme.Badge.Background}" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Theme.Card.Border}"/>

                                    <!-- Status glyph -->
                                    <TextBlock Grid.Column="0" Text="{Binding Status, Converter={StaticResource ProbeStatusToGlyphConverter}}"
                                               FontSize="12" FontFamily="Marlett" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}" Padding="8,0,0,0"/>
    
                                    <!-- Hostname textbox -->
                                    <TextBox Name="Hostname" Grid.Column="1" FontWeight="Medium" FontSize="13" VerticalContentAlignment="Center"
                                             Background="Transparent" BorderThickness="0" Padding="5,6"
                                             Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsActive, Converter={StaticResource InverseBooleanConverter}}"
                                             Template="{StaticResource TextBoxControlTemplate}"/>
    
                                    <!-- Category Badge -->
                                    <Border Grid.Column="2" 
                                            HorizontalAlignment="Right"
                                            Background="{DynamicResource Theme.Accent}" 
                                            Opacity="0.8"
                                            CornerRadius="10" 
                                            Padding="8,2" 
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold" Foreground="White" Opacity="0.9"/>
                                    </Border>
    
                                    <!-- Ping button -->
                                    <Button Click="ProbeStartStop_Click" Grid.Column="3" Margin="4">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Name="pingButton_border" CornerRadius="4" Padding="12,4" Background="{DynamicResource Theme.Accent}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding IsActive, Converter={StaticResource BooleanToImageConverter}}" Width="12" Height="12"/>
                                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStringConverter}}" Visibility="{Binding ElementName=History, Path=ActualWidth, Converter={StaticResource ButtonTextVisibilityConverter}}"
                                                                   Foreground="White" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="pingButton_border" Property="Background" Value="{DynamicResource Theme.Status.Info.Foreground}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="pingButton_border" Property="Background" Value="{DynamicResource Theme.Status.Down.Foreground}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
    
            </ItemsControl>
        </ScrollViewer>
        </DockPanel>

        <!-- Modal Overlay -->
        <Grid Name="ProbeDetailsModal" Visibility="Collapsed" Panel.ZIndex="1000">
             <Border Background="#80000000" MouseLeftButtonUp="CloseModal_Click"/>
             <Border Background="{DynamicResource Theme.Card.Background}" CornerRadius="16" Width="780" Height="610" MaxWidth="{Binding ActualWidth, ElementName=ProbeDetailsModal, Converter={StaticResource ModalWidthConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" RenderTransformOrigin="0.5,0.5">
                 <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                 </Border.RenderTransform>
                 <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=ProbeDetailsModal}" Value="Visible">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.96" To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.96" To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                 </Border.Style>
                 <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="#000000" RenderingBias="Performance"/>
                 </Border.Effect>
                 <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <Border Grid.Row="0" Background="{DynamicResource Theme.Badge.Background}" Padding="20" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Theme.Card.Border}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Click="CloseModal_Click" Content="✕" FontSize="16" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                             <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource icon.vmping-logo-simple}" Width="32" Height="32" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Hostname}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                        <Button Content="Copiar" FontSize="10" Padding="8,2" Background="{DynamicResource Theme.Card.Border}" Foreground="{DynamicResource Theme.Text.Secondary}" BorderThickness="0" Click="CopyHostname_Click" VerticalAlignment="Center">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="Editar alias" FontSize="10" Padding="8,2" Background="{DynamicResource Theme.Card.Border}" Foreground="{DynamicResource Theme.Text.Secondary}" BorderThickness="0" Click="EditAliasModal_Click" VerticalAlignment="Center" Margin="5,0,0,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Status}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource ProbeStatusToForegroundBrushConverter}}"/>
                                        <TextBlock Text=" - " Foreground="{DynamicResource Theme.Text.Muted}"/>
                                        <TextBlock Text="{Binding Alias}" FontSize="14" Foreground="{DynamicResource Theme.Text.Secondary}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="IP:" FontSize="12" Foreground="{DynamicResource Theme.Text.Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Name="txtModalIP" Text="Resolviendo..." FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="4,0,8,0" VerticalAlignment="Center"/>
                                        <Button Content="Copiar IP" FontSize="10" Padding="8,2" Background="{DynamicResource Theme.Card.Border}" Foreground="{DynamicResource Theme.Text.Secondary}" BorderThickness="0" Click="CopyIp_Click" VerticalAlignment="Center">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource Theme.Text.Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                             </StackPanel>
                        </DockPanel>
                    </Border>
                    
                    <!-- Stats Row 1: Sent / Received / Lost -->
                    <Grid Grid.Row="1" Margin="20,16,20,0">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="*"/>
                         </Grid.ColumnDefinitions>
                         <Border Grid.Column="0" Background="{DynamicResource Theme.Status.Up.Background}" CornerRadius="10" Margin="5" Padding="15">
                             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                 <TextBlock Text="ENVIADOS" FontSize="12" Foreground="{DynamicResource Theme.Status.Up.Foreground}" FontWeight="Bold"/>
                                 <TextBlock Text="{Binding Statistics.Sent}" FontSize="32" Foreground="{DynamicResource Theme.Status.Up.Foreground}" HorizontalAlignment="Center" FontWeight="Light"/>
                             </StackPanel>
                         </Border>
                         <Border Grid.Column="1" Background="{DynamicResource Theme.Status.Info.Background}" CornerRadius="10" Margin="5" Padding="15">
                             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                 <TextBlock Text="RECIBIDOS" FontSize="12" Foreground="{DynamicResource Theme.Status.Info.Foreground}" FontWeight="Bold"/>
                                 <TextBlock Text="{Binding Statistics.Received}" FontSize="32" Foreground="{DynamicResource Theme.Status.Info.Foreground}" HorizontalAlignment="Center" FontWeight="Light"/>
                             </StackPanel>
                         </Border>
                         <Border Grid.Column="2" Background="{DynamicResource Theme.Status.Down.Background}" CornerRadius="10" Margin="5" Padding="15">
                             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                 <TextBlock Text="PERDIDOS" FontSize="12" Foreground="{DynamicResource Theme.Status.Down.Foreground}" FontWeight="Bold"/>
                                 <TextBlock Text="{Binding Statistics.Lost}" FontSize="32" Foreground="{DynamicResource Theme.Status.Down.Foreground}" HorizontalAlignment="Center" FontWeight="Light"/>
                             </StackPanel>
                         </Border>
                    </Grid>

                    <!-- Stats Row 2: Latency + ratios -->
                    <Grid Grid.Row="2" Margin="20,0,20,0">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="*"/>
                         </Grid.ColumnDefinitions>
                         <Border Grid.Column="0" Background="{DynamicResource Theme.Badge.Background}" CornerRadius="10" Margin="5" Padding="12">
                             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                 <TextBlock Text="LATENCIA MÍN" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" FontWeight="Bold"/>
                                 <TextBlock Text="{Binding Statistics.MinRtt, StringFormat={}{0} ms}" FontSize="22" Foreground="{DynamicResource Theme.Text.Primary}" HorizontalAlignment="Center" FontWeight="Light"/>
                             </StackPanel>
                         </Border>
                         <Border Grid.Column="1" Background="{DynamicResource Theme.Badge.Background}" CornerRadius="10" Margin="5" Padding="12">
                             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                 <TextBlock Text="LATENCIA PROM" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" FontWeight="Bold"/>
                                 <TextBlock Text="{Binding Statistics.AvgRtt, StringFormat={}{0:0.##} ms}" FontSize="22" Foreground="{DynamicResource Theme.Text.Primary}" HorizontalAlignment="Center" FontWeight="Light"/>
                             </StackPanel>
                         </Border>
                         <Border Grid.Column="2" Background="{DynamicResource Theme.Badge.Background}" CornerRadius="10" Margin="5" Padding="12">
                             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                 <TextBlock Text="LATENCIA MÁX" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" FontWeight="Bold"/>
                                 <TextBlock Text="{Binding Statistics.MaxRtt, StringFormat={}{0} ms}" FontSize="22" Foreground="{DynamicResource Theme.Text.Primary}" HorizontalAlignment="Center" FontWeight="Light"/>
                             </StackPanel>
                         </Border>
                         <Border Grid.Column="3" Background="{DynamicResource Theme.Badge.Background}" CornerRadius="10" Margin="5" Padding="12">
                             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                 <TextBlock Text="DISPONIBILIDAD" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" FontWeight="Bold"/>
                                 <TextBlock HorizontalAlignment="Center" FontSize="22" Foreground="{DynamicResource Theme.Text.Primary}" FontWeight="Light">
                                     <TextBlock.Text>
                                         <MultiBinding Converter="{StaticResource AvailabilityPercentageConverter}">
                                             <Binding Path="Statistics.Received"/>
                                             <Binding Path="Statistics.Sent"/>
                                         </MultiBinding>
                                     </TextBlock.Text>
                                 </TextBlock>
                                 <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" FontWeight="Bold">
                                     <TextBlock.Text>
                                         <MultiBinding Converter="{StaticResource LossPercentageConverter}">
                                             <Binding Path="Statistics.Lost"/>
                                             <Binding Path="Statistics.Sent"/>
                                         </MultiBinding>
                                     </TextBlock.Text>
                                 </TextBlock>
                             </StackPanel>
                         </Border>
                    </Grid>

                    <!-- Sparkline -->
                    <Border Grid.Row="3" Margin="25,10,25,0" Background="{DynamicResource Theme.Badge.Background}" CornerRadius="8">
                        <Grid>
                            <Polyline Points="{Binding LatencyHistory, Converter={StaticResource LatencyHistoryToPointsConverter}}"
                                      Stroke="{Binding Status, Converter={StaticResource ProbeStatusToStatisticsBrushConverter}}"
                                      StrokeThickness="2"
                                      Stretch="Fill"
                                      Height="42"
                                      Margin="10,4"
                                      IsHitTestVisible="False"/>
                            <TextBlock Text="Latencia en vivo (ms)" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,10,0"/>
                        </Grid>
                    </Border>

                    <!-- Tools Section: Quick Actions -->
