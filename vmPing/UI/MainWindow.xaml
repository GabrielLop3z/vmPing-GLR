                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                         <Button Content="Cancelar" Click="AddProbe_Cancel_Click" Background="Transparent" Foreground="{DynamicResource Theme.Text.Secondary}" BorderThickness="0" Margin="0,0,10,0" Padding="10,5"/>
                         <Button Content="Añadir" Click="AddProbe_Save_Click" Background="{DynamicResource Theme.Accent}" Foreground="White" Padding="20,10" BorderThickness="0" FontWeight="SemiBold">
                            <Button.Resources>
