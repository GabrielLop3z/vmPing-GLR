<Window x:Class="vmPing.UI.HealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salud en Vivo - vmPing GLR"
        Height="700" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Window.Foreground}"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Salud en Vivo" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
            <TextBlock x:Name="lblSubtitle" Text="Monitoreo de CPU, memoria y disco mediante WMI..." FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource Theme.Card.Background}" BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnToggle" Content="Pausar" Padding="14,6" Margin="0,0,8,0"
                            Background="{DynamicResource Theme.Accent}" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Click="BtnToggle_Click"/>
                    <Button x:Name="btnNow" Content="Recolectar ahora" Padding="14,6" Margin="0,0,8,0"
                            Background="{DynamicResource Theme.Badge.Background}" BorderBrush="{DynamicResource Theme.Card.Border}"
                            BorderThickness="1" Foreground="{DynamicResource Theme.Text.Primary}" Cursor="Hand" Click="BtnNow_Click"/>
                    <Button x:Name="btnExportExcel" Content="Exportar Excel" Padding="14,6" Margin="0,0,8,0"
                            Background="{DynamicResource Theme.Badge.Background}" BorderBrush="{DynamicResource Theme.Card.Border}"
                            BorderThickness="1" Foreground="{DynamicResource Theme.Text.Primary}" Cursor="Hand" Click="BtnExportExcel_Click"/>
                    <Button x:Name="btnExportHtml" Content="Exportar HTML" Padding="14,6" Margin="0,0,8,0"
                            Background="{DynamicResource Theme.Badge.Background}" BorderBrush="{DynamicResource Theme.Card.Border}"
                            BorderThickness="1" Foreground="{DynamicResource Theme.Text.Primary}" Cursor="Hand" Click="BtnExportHtml_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Intervalo (segundos):" FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtInterval" Width="70" Padding="4,2"
                             Background="{DynamicResource Theme.Badge.Background}" Foreground="{DynamicResource Theme.Text.Primary}"
                             BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                             PreviewTextInput="NumericTextbox_PreviewTextInput" MaxLength="3"/>
                    <Button x:Name="btnApplyInterval" Content="Aplicar" Padding="10,4" Margin="6,0,0,0"
                            Background="{DynamicResource Theme.Badge.Background}" BorderBrush="{DynamicResource Theme.Card.Border}"
                            BorderThickness="1" Foreground="{DynamicResource Theme.Text.Primary}" Cursor="Hand" Click="BtnApplyInterval_Click"/>
                </StackPanel>

                <TextBlock x:Name="lblCount" Grid.Column="2" FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" Background="{DynamicResource Theme.Card.Background}" BorderBrush="{DynamicResource Theme.Card.Border}"
                BorderThickness="1" CornerRadius="10" Padding="0">
            <DataGrid x:Name="dgHealth" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="{DynamicResource Theme.Card.Background}"
                      AlternatingRowBackground="{DynamicResource Theme.Badge.Background}"
                      Foreground="{DynamicResource Theme.Text.Primary}"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="{DynamicResource Theme.Badge.Background}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Card.Border}"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Equipo" Binding="{Binding Host}" Width="170"/>
                    <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="150"/>
                    <DataGridTemplateColumn Header="CPU (%)" Width="215">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CpuText}" MinWidth="46" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Polyline Points="{Binding CpuPoints}" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="1.5" Width="150" Height="30" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Memoria (%)" Width="215">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RamText}" MinWidth="46" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Polyline Points="{Binding RamPoints}" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="1.5" Width="150" Height="30" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Disco (%)" Width="215">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DiskText}" MinWidth="46" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Polyline Points="{Binding DiskPoints}" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="1.5" Width="150" Height="30" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Discos" Binding="{Binding DisksText}" Width="200"/>
                    <DataGridTextColumn Header="Actualizado" Binding="{Binding LastUpdateText}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status -->
        <StatusBar Grid.Row="3" Background="Transparent" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="La recolección se ejecuta periódicamente según el intervalo." FontSize="11"
                           Foreground="{DynamicResource Theme.Text.Secondary}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>