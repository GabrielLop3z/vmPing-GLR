<Window x:Class="vmPing.UI.ApiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API HTTP - vmPing GLR"
        Height="600" Width="820"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Window.Foreground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="API HTTP local" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource Theme.Text.Primary}"/>
            <TextBlock Text="Integre vmPing con bitácoras, paneles y otras aplicaciones"
                       FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Theme.Card.Background}"
                BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Estado:" FontWeight="SemiBold" Margin="0,0,10,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblStatus" Text="Detenida" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="URL local:" FontWeight="SemiBold" Margin="0,0,10,4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblLocalUrl" Text="-" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="URL de red:" FontWeight="SemiBold" Margin="0,0,10,4"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="lblLanUrl" Text="-" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Clave API:" FontWeight="SemiBold" Margin="0,0,10,4"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock x:Name="lblKey" Text="-" VerticalAlignment="Center"/>
                    <Button x:Name="btnCopyKey" Content="Copiar clave" Padding="8,2" Margin="10,0,0,0"
                            Visibility="Collapsed" Cursor="Hand" Click="BtnCopyKey_Click"
                            ToolTip="Copia la clave para usarla en X-Api-Key o ?key=."
                            Background="{DynamicResource Theme.Card.Background}"
                            Foreground="{DynamicResource Theme.Text.Primary}"
                            BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Base de datos:" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="lblDatabase" Text="-" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Theme.Card.Background}"
                BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1"
                CornerRadius="10" Padding="16">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Endpoints principales"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{DynamicResource Theme.Text.Primary}"/>
                <TextBox x:Name="txtEndpoints" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource Theme.Text.Secondary}"
                         FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <TextBlock x:Name="lblCopyFeedback" VerticalAlignment="Center" HorizontalAlignment="Left"
                       FontSize="12" FontWeight="SemiBold" Opacity="0"
                       Foreground="{DynamicResource Theme.Status.Up.Foreground}"
                       Text="URL copiada al portapapeles"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copiar URL" Padding="14,7" Margin="0,0,8,0"
                    Background="{DynamicResource Theme.Accent}" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                    Click="BtnCopy_Click"/>
            <Button Content="Abrir en navegador" Padding="14,7" Margin="0,0,8,0"
                    Background="{DynamicResource Theme.Status.Info.Foreground}" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                    Click="BtnOpen_Click"/>
            <Button Content="Refrescar" Padding="14,7" Margin="0,0,8,0"
                    Background="{DynamicResource Theme.Card.Background}" Foreground="{DynamicResource Theme.Text.Primary}"
                    BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1" Cursor="Hand"
                    Click="BtnRefresh_Click"/>
            <Button Content="Cerrar" Padding="14,7" Click="BtnClose_Click"
                    Background="{DynamicResource Theme.Card.Background}" Foreground="{DynamicResource Theme.Text.Primary}"
                    BorderBrush="{DynamicResource Theme.Card.Border}" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
